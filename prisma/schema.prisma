generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  INITIATED
  RINGING
  ACCEPTED
  CONNECTING
  CONNECTED
  REJECTED
  TIMEOUT
  CANCELLED
  FAILED
  ENDED
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum LedgerReason {
  PAYMENT_TOPUP
  CALL_CHARGE
  CALL_REFUND
  ADMIN_ADJUSTMENT
  PROMOTIONAL_CREDIT
  CREATOR_EARNING
  PAYOUT
  /// Razorpay (or other gateway) refund of a wallet top-up. Not a call refund.
  PAYMENT_REFUND
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportReason {
  HARASSMENT
  SPAM
  INAPPROPRIATE_CONTENT
  FRAUD
  OTHER
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum HostStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum HostAvailability {
  OFFLINE
  ONLINE
  BUSY
  PAUSED
}

/// Admin/manual verification. External KYC provider is CONFIG_REQUIRED.
enum HostVerificationStatus {
  NOT_REQUIRED
  PENDING
  VERIFIED
  REJECTED
}

/// One operating mode per account. Account login status stays on User.status.
enum OperatingMode {
  USER
  HOST
}

/// Host account login eligibility, mirroring UserStatus. Independent of
/// HostStatus, which is the application/approval state.
enum HostAccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  /// Scopes an ADMIN account's /admin/* access to a StaffRole's permission
  /// set. Null on an ADMIN means unrestricted (today's behavior, unchanged).
  /// Meaningless for a non-ADMIN role.
  staffRoleId  String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  staffRole       StaffRole?          @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  supervisedHosts HostSupervision[]   @relation("Supervisor")
  supervision     HostSupervision?    @relation("SupervisedHost")
  profile         Profile?
  wallet          Wallet?
  refreshTokens   RefreshToken[]
  callerCalls     Call[]              @relation("CallCaller")
  calleeCalls     Call[]              @relation("CallCallee")
  payments        Payment[]
  deviceTokens    DeviceToken[]
  notifications   AppNotification[]
  blocksInitiated Block[]            @relation("Blocker")
  blocksReceived  Block[]            @relation("Blocked")
  reportsFiled    Report[]            @relation("Reporter")
  reportsAgainst  Report[]            @relation("Reported")
  analyticsEvents AnalyticsEvent[]
  auditLogs       AuditLog[]
  conversationsA  Conversation[]     @relation("ConversationA")
  conversationsB  Conversation[]     @relation("ConversationB")
  messagesSent    Message[]
  payoutRequests  PayoutRequest[]
  payoutDestinations PayoutDestination[]
  hostProfile     HostProfile?
  notificationPreferences NotificationPreference?

  @@index([status, createdAt])
  @@index([staffRoleId])
}

/// A dynamically creatable internal-staff role (Platform Manager,
/// Coordinator, etc). The role set is dynamic; the permission vocabulary
/// each role draws `permissions` from is a fixed catalog defined in
/// src/common/permissions.ts, so a permission check can never typo-silently
/// pass.
model StaffRole {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[]
}

/// Which staff member (User.role == ADMIN) a given host reports to, for
/// support/escalation routing. One active supervisor per host.
model HostSupervision {
  id          String   @id @default(uuid())
  hostUserId  String   @unique
  staffUserId String
  assignedAt  DateTime @default(now())

  host     HostProfile @relation(fields: [hostUserId], references: [userId], onDelete: Cascade, map: "HostSupervision_host_fkey")
  staff    User        @relation("Supervisor", fields: [staffUserId], references: [id], onDelete: Cascade)
  hostUser User        @relation("SupervisedHost", fields: [hostUserId], references: [id], onDelete: Cascade, map: "HostSupervision_hostUser_fkey")

  @@index([staffUserId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([familyId])
}

model Profile {
  userId               String    @id
  displayName          String
  bio                  String    @default("")
  gender               Gender    @default(UNSPECIFIED)
  country              String?
  language             String?
  avatarUrl            String?
  /// HOST only while HostProfile.status is ACTIVE. Never combined with a user operating mode.
  operatingMode        OperatingMode @default(USER)
  isDiscoverable       Boolean   @default(true)
  ratePerMinuteCents   Int       @default(100)
  lastActiveAt         DateTime  @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Discovery feed: discoverable profiles ordered by recency.
  @@index([isDiscoverable, lastActiveAt(sort: Desc)])
  // Language filter on the discovery feed.
  @@index([language, isDiscoverable, lastActiveAt(sort: Desc)])
}

model HostProfile {
  userId                    String                 @id
  status                    HostStatus             @default(PENDING_REVIEW)
  availability              HostAvailability       @default(OFFLINE)
  verificationStatus        HostVerificationStatus @default(NOT_REQUIRED)
  voiceEnabled              Boolean                @default(true)
  videoEnabled              Boolean                @default(true)
  voiceRatePerMinuteCents   Int                    @default(100)
  videoRatePerMinuteCents   Int                    @default(150)
  languages                 String[]               @default([])
  interests                 String[]               @default([])
  applicationBio            String                 @default("")
  /// Host-facing review / rejection message (safe to show the applicant).
  reviewNote                String?
  /// Internal admin moderation note — never returned on host/public APIs.
  internalNote              String?
  submittedAt               DateTime               @default(now())
  reviewedAt                DateTime?
  reviewedById              String?
  /// Sensitive identity document metadata. The file itself is not stored in the database.
  idProofType               String?
  idProofLast4              String?
  idProofMime               String?
  idProofUpdatedAt          DateTime?
  /// Full identity number for admin review only. Never returned on public discovery.
  identityCardNumber        String?
  identityFrontMime         String?
  identityBackMime          String?
  profileImageMime          String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  user                 User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreementAcceptances HostAgreementAcceptance[]
  supervision          HostSupervision?

  @@index([status, availability])
  @@index([status, updatedAt])
  @@index([status, verificationStatus])
}

/// Versioned mandatory agreement acceptances for host eligibility.
model HostAgreementAcceptance {
  id            String   @id @default(uuid())
  userId        String
  agreementType String
  version       String
  acceptedAt    DateTime @default(now())

  host HostProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, agreementType, version])
  @@index([userId, agreementType])
}

/// Standalone host identity, step 1 of the User/Host account split (Phase 4A).
/// Not yet wired into any application code or FK'd from elsewhere — this
/// table and its satellites exist in parallel with HostProfile/User and are
/// backfilled from them, so this migration stays purely additive and safe
/// to apply without touching any existing read/write path. A later migration
/// (Phase 4A, part 2) repoints HostSupervision/PayoutDestination/PayoutRequest
/// at this table once every row here is confirmed backfilled; HostProfile and
/// the old User row for each host are removed only once Phase 4C has moved
/// Call/Conversation/Message/Block/Report off the old User id.
///
/// id intentionally reuses the host's existing User.id (decision: no FK
/// rewriting needed anywhere once the cutover happens, since every existing
/// row that points at "this host" already holds the right UUID).
model Host {
  id                      String                 @id
  phone                   String                 @unique
  email                   String?
  accountStatus           HostAccountStatus      @default(ACTIVE)
  status                  HostStatus             @default(PENDING_REVIEW)
  availability            HostAvailability       @default(OFFLINE)
  verificationStatus      HostVerificationStatus @default(NOT_REQUIRED)

  /// Discovery-facing profile, absorbed from the generic Profile model since
  /// a host's profile is never shared with a caller-mode account once split.
  displayName             String                 @default("")
  bio                     String                 @default("")
  gender                  Gender                 @default(UNSPECIFIED)
  country                 String?
  language                String?
  avatarUrl               String?
  isDiscoverable          Boolean                @default(true)
  lastActiveAt            DateTime               @default(now())

  voiceEnabled            Boolean                @default(true)
  videoEnabled            Boolean                @default(true)
  voiceRatePerMinuteCents Int                    @default(100)
  videoRatePerMinuteCents Int                    @default(150)
  languages               String[]               @default([])
  interests               String[]               @default([])
  applicationBio          String                 @default("")
  /// Host-facing review / rejection message (safe to show the applicant).
  reviewNote              String?
  /// Internal admin moderation note — never returned on host/public APIs.
  internalNote            String?
  submittedAt             DateTime               @default(now())
  reviewedAt              DateTime?
  reviewedById            String?
  /// Sensitive identity document metadata. The file itself is not stored in the database.
  idProofType             String?
  idProofLast4            String?
  idProofMime             String?
  idProofUpdatedAt        DateTime?
  /// Full identity number for admin review only. Never returned on public discovery.
  identityCardNumber      String?
  identityFrontMime       String?
  identityBackMime        String?
  profileImageMime        String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  wallet                  HostWallet?
  refreshTokens           HostRefreshToken[]
  deviceTokens            HostDeviceToken[]
  notifications           HostAppNotification[]
  notificationPreferences HostNotificationPreference?

  @@index([status, availability])
  @@index([status, updatedAt])
  @@index([status, verificationStatus])
  @@index([isDiscoverable, lastActiveAt(sort: Desc)])
  @@index([language, isDiscoverable, lastActiveAt(sort: Desc)])
}

model HostRefreshToken {
  id        String    @id @default(uuid())
  hostId    String
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, createdAt])
  @@index([familyId])
}

model HostDeviceToken {
  id        String   @id @default(uuid())
  hostId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
}

model HostAppNotification {
  id        String             @id @default(uuid())
  hostId    String
  type      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(PENDING)
  readAt    DateTime?
  createdAt DateTime           @default(now())

  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, createdAt(sort: Desc)])
}

/// Per-host push/in-app notification preferences, mirroring NotificationPreference.
model HostNotificationPreference {
  hostId       String   @id
  incomingCall Boolean  @default(true)
  chatMessage  Boolean  @default(true)
  payout       Boolean  @default(true)
  system       Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  host Host @relation(fields: [hostId], references: [id], onDelete: Cascade)
}

/// Host call-earnings wallet, forked out of the generic Wallet table since a
/// host's earnings and a caller's spend are no longer the same identity.
model HostWallet {
  id                    String   @id @default(uuid())
  hostId                String   @unique
  currency              String   @default("USD")
  availableBalanceCents Int      @default(0)
  heldBalanceCents      Int      @default(0)
  version               Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  host   Host                    @relation(fields: [hostId], references: [id], onDelete: Restrict)
  ledger HostWalletLedgerEntry[]
}

model HostWalletLedgerEntry {
  id                String          @id @default(uuid())
  walletId          String
  type              LedgerEntryType
  reason            LedgerReason
  amountCents       Int
  balanceAfterCents Int
  idempotencyKey    String          @unique
  referenceType     String?
  referenceId       String?
  metadata          Json?
  createdAt         DateTime        @default(now())

  wallet HostWallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([referenceType, referenceId])
}

model Wallet {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  currency               String   @default("USD")
  availableBalanceCents  Int      @default(0)
  heldBalanceCents        Int      @default(0)
  version                Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user   User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger  WalletLedgerEntry[]
}

model WalletLedgerEntry {
  id                String          @id @default(uuid())
  walletId          String
  type              LedgerEntryType
  reason            LedgerReason
  amountCents       Int
  balanceAfterCents Int
  idempotencyKey    String           @unique
  referenceType     String?
  referenceId       String?
  metadata          Json?
  createdAt         DateTime       @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([referenceType, referenceId])
}

model Payment {
  id                 String        @id @default(uuid())
  userId             String
  amountCents        Int
  currency           String       @default("USD")
  status             PaymentStatus @default(PENDING)
  provider           String
  providerPaymentId String        @unique
  idempotencyKey     String        @unique
  clientSecret       String?
  failureReason      String?
  rechargePlanId     String?
  creditCents        Int?
  /// Razorpay payment id (pay_...) after checkout. Order id stays in providerPaymentId.
  providerCaptureId  String?
  /// NONE | PENDING | PROCESSED | FAILED. Payment.status stays SUCCEEDED until capture.
  refundStatus       String        @default("NONE")
  refundAttempt      Int           @default(0)
  providerRefundId   String?       @unique
  refundedAmountCents Int          @default(0)
  /// OK | PENDING | AMOUNT_MISMATCH | CURRENCY_MISMATCH | ORDER_MISMATCH | PROVIDER_AHEAD | INTERNAL_AHEAD
  reconciliationStatus String      @default("OK")
  capturedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([providerCaptureId])
}

model ProviderEvent {
  id          String   @id @default(uuid())
  provider    String
  eventId     String
  eventType   String
  payloadHash String
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
}

model Call {
  id                   String     @id @default(uuid())
  callerId             String
  calleeId             String
  callType             CallType   @default(VOICE)
  status               CallStatus @default(INITIATED)
  version              Int        @default(0)
  provider             String
  providerSessionId    String     @unique
  /// Client create idempotency. Unique when set — retries return the same call.
  idempotencyKey       String?    @unique
  ratePerMinuteCents   Int
  /// Share copied when the call was created. Settlement must not read a later config.
  creatorShareBps      Int?
  billedSeconds        Int        @default(0)
  billedAmountCents    Int        @default(0)
  heldAmountCents      Int        @default(0)
  /// Set when settle() successfully applies ledger charge (idempotent).
  settlementAppliedAt  DateTime?
  connectedAt          DateTime?
  endedAt              DateTime?
  endReason            String?
  callerHeartbeatAt    DateTime?
  calleeHeartbeatAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime @updatedAt

  caller User        @relation("CallCaller", fields: [callerId], references: [id], onDelete: Restrict)
  callee User        @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Restrict)
  events CallEvent[]

  @@index([callerId, createdAt(sort: Desc)])
  @@index([calleeId, createdAt(sort: Desc)])
  @@index([status, updatedAt])
}

model CallEvent {
  id        String   @id @default(uuid())
  callId    String
  fromStatus CallStatus?
  toStatus   CallStatus
  actorId    String?
  source     String
  note       String?
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, createdAt])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id            String       @id @default(uuid())
  reporterId    String
  reportedId    String
  reason        ReportReason
  details       String       @default("")
  status        ReportStatus @default(OPEN)
  /// Optional linked resource: call | conversation | message
  referenceType String?
  referenceId   String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Restrict)

  @@index([reportedId, status, createdAt])
  @@index([reporterId, createdAt])
  @@index([referenceType, referenceId])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AppNotification {
  id        String             @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  status    NotificationStatus @default(PENDING)
  readAt    DateTime?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String?
  eventType  String
  properties Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}

model Conversation {
  id              String   @id @default(uuid())
  participantAId  String
  participantBId  String
  lastMessageAt   DateTime @default(now())
  lastMessagePreview String @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  participantA User      @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Restrict)
  participantB User      @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Restrict)
  messages     Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, lastMessageAt(sort: Desc)])
  @@index([participantBId, lastMessageAt(sort: Desc)])
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String
  idempotencyKey String    @unique
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId, createdAt])
}

model PayoutDestination {
  id          String   @id @default(uuid())
  userId      String
  /// BANK | UPI | PAYPAL | OTHER — BUSINESS_RULE_REQUIRED for provider rails
  type        String
  label       String   @default("")
  /// Opaque destination payload (account last4, upi handle, etc). Never log secrets.
  detailsJson Json
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  payouts PayoutRequest[]

  @@index([userId, isDefault])
}

model PayoutRequest {
  id             String       @id @default(uuid())
  userId         String
  destinationId  String?
  amountCents    Int
  status         PayoutStatus @default(REQUESTED)
  failureReason  String?
  idempotencyKey String       @unique
  /// NOT_TRANSFERRED until a payout rail returns a provider transfer id.
  externalTransferStatus String @default("NOT_TRANSFERRED")
  providerTransferId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  processedAt    DateTime?

  user        User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  destination PayoutDestination? @relation(fields: [destinationId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

/// Per-user push/in-app notification preferences.
model NotificationPreference {
  userId             String   @id
  incomingCall       Boolean  @default(true)
  chatMessage        Boolean  @default(true)
  payment            Boolean  @default(true)
  wallet             Boolean  @default(true)
  host               Boolean  @default(true)
  payout             Boolean  @default(true)
  system             Boolean  @default(true)
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Singleton call price. Missing row means hosts keep their own rates and CREATOR_SHARE_BPS.
model PlatformPricing {
  id                      String   @id @default("default")
  userRatePerMinuteCents  Int
  hostEarningPerMinuteCents Int
  hostShareBps            Int
  /// Optional global override for VIDEO calls. When unset, video calls fall
  /// back to each host's own videoRatePerMinuteCents (never to the voice
  /// rate above). hostShareBps is reused for both call types.
  userVideoRatePerMinuteCents Int?
  updatedById             String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

/// Admin-managed wallet recharge catalog. Amounts are integer minor units.
model RechargePlan {
  id                 String   @id @default(uuid())
  name               String
  priceMinor         Int
  walletCreditMinor  Int
  bonusMinor         Int      @default(0)
  /// Coins shown on the recharge card. Set in admin; not derived from the rupee price.
  coins              Int      @default(0)
  bonusCoins         Int      @default(0)
  description        String   @default("")
  isActive           Boolean  @default(true)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, displayOrder])
}

/// Home-screen promotional banners (admin-managed).
model PromoBanner {
  id          String    @id @default(uuid())
  title       String
  subtitle    String    @default("")
  /// Optional CDN/image URL. UI falls back to brand gradient when empty.
  imageUrl    String?
  /// In-app deep link path, e.g. /wallet, /discover, /host/apply
  ctaLabel    String    @default("Learn more")
  deepLink    String?
  /// ALL | USER | HOST
  audience    String    @default("ALL")
  priority    Int       @default(0)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, priority(sort: Desc), createdAt(sort: Desc)])
  @@index([audience, isActive])
}
