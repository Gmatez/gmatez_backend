NODE_ENV=development
PORT=43121
HOST=0.0.0.0

DATABASE_URL=postgresql://ubuntu:postgres@127.0.0.1:5432/social_calling?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# development/test: mock defaults OK when omitted
# staging/production: set explicitly — production rejects mock
OTP_PROVIDER=mock
CALLING_PROVIDER=agora
PAYMENT_PROVIDER=mock
PUSH_PROVIDER=mock

# OTP security (defaults shown)
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_WINDOW=5
OTP_SEND_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_IP_WINDOW=20
OTP_MAX_VERIFY_PER_WINDOW=10
OTP_VERIFY_WINDOW_SECONDS=3600
SUPPORTED_PHONE_REGIONS=IN,US,GB
DEFAULT_PHONE_REGION=IN

PAYMENT_WEBHOOK_SECRET=replace-payment-webhook-secret
# Razorpay (required when PAYMENT_PROVIDER=razorpay). Never commit real values.
# Key secret and webhook secret stay on the server. Flutter receives only RAZORPAY_KEY_ID.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Book currency for new wallets. Defaults to INR when PAYMENT_PROVIDER=razorpay, otherwise USD.
# PLATFORM_CURRENCY=INR
CALLING_WEBHOOK_SECRET=replace-calling-webhook-secret
OTP_PEPPER=replace-otp-pepper-at-least-32-chars

LOG_LEVEL=info
CORS_ORIGINS=http://localhost:43121,http://localhost:3000

# Local/test only. NEVER valid in production.
# ALLOW_MOCK_PROVIDERS=true
# MOCK_OTP=123456

# When OTP_PROVIDER=sms (production/staging):
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
# # India DLT: template must be approved; OTP variable name per MSG91 template.
# # OR
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

FIREBASE_SERVICE_ACCOUNT_JSON=
STRIPE_SECRET_KEY=
AGORA_APP_ID=5ad172257e22430eb77ad67637cbe38a
AGORA_APP_CERTIFICATE=b3da9dc84e564462bf254506fa0c42db
# Short-lived RTC token TTL (seconds). Clients renew via POST /calls/:id/rtc-token.
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Host share of billed call amount in basis points (8000 = 80%). BUSINESS_RULE_REQUIRED to change.
CREATOR_SHARE_BPS=8000

# Production checklist (never use mock in NODE_ENV=production):
# OTP_PROVIDER=sms
# CALLING_PROVIDER=agora
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# PLATFORM_CURRENCY=INR
# Stripe remains available but is not the Indian checkout path.
# PAYMENT_PROVIDER=stripe
# PUSH_PROVIDER=fcm
# STRIPE_SECRET_KEY=sk_live_...
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
